    "build:renderers": "node scripts/build-renderers.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.7",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "mermaid": "12.2.0"
  }
