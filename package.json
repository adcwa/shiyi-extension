{
  "name": "dianyi-extension",
  "version": "0.14.3",
  "private": true,
  "type": "module",
  "description": "点译：自有模型按需翻译，已存词句跨网页主动提示",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:page": "node scripts/e2e.mjs tests/page_translation_e2e.py",
